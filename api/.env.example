# GHL (doc 01: all calls require header `Version: 2021-07-28`)
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_ACCESS_TOKEN=ghl_oauth_token_or_pit
GHL_LOCATION_ID=demo_loc_001
GHL_WEBHOOK_SECRET=whsec_demo_secret

# Meta
META_API_VERSION=v25.0
META_ACCESS_TOKEN=EAAG...
META_AD_ACCOUNT_ID=act_123456789
META_APP_SECRET=your_app_secret

# Google Ads (API v24; doc 06: mock mode for demo until Basic Access approved)
GOOGLE_ADS_API_VERSION=v24
GOOGLE_DEVELOPER_TOKEN=your_developer_token
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
GOOGLE_CUSTOMER_ID=123-456-7890
GOOGLE_LOGIN_CUSTOMER_ID=your_manager_account_id

# Database (docker-compose host ports)
DATABASE_URL=postgresql://attribution:attribution_dev@localhost:5440/attribution_db
REDIS_URL=redis://localhost:6380/0

# Dashboard
JWT_SECRET=your_jwt_secret
DASHBOARD_TOKEN=demo-token
DASHBOARD_API_PORT=3100

# Demo mode (doc 06): Meta live, Google simulated/mock by default
DEMO_MODE_META=live
DEMO_MODE_GOOGLE=mock

# Environment
NODE_ENV=development
LOG_LEVEL=info
